---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { getAllCaseData } from "@lib/caseData";
import { formatDate } from "@lib/site";
const cases = getAllCaseData();
const updates = cases.flatMap((item) => item.updates.map((update) => ({ ...update, caseName: item.caseName, slug: item.slug }))).sort((a, b) => b.date.localeCompare(a.date) || a.caseName.localeCompare(b.caseName));
const groups = Object.entries(Object.groupBy(updates, (item) => item.date));
const breadcrumbs = [{ name: "Home", url: "/" }, { name: "Latest Updates", url: "/updates/" }];
---
<BaseLayout title="Latest Lawsuit Updates" seoTitle="Latest Lawsuit Updates: September 2026" description="A dated log of verified MDL counts, court schedules, settlement developments and status changes across major U.S. lawsuits." canonicalPath="/updates/" breadcrumbs={breadcrumbs}>
  <div class="mx-auto max-w-5xl px-4 py-6 md:py-10"><Breadcrumbs items={breadcrumbs}/><header class="max-w-3xl"><h1 class="text-4xl font-black">Latest Lawsuit Updates</h1><p class="mt-4 text-lg leading-8 text-muted">A dated record of changes made from official court, agency, JPML and settlement-administration sources.</p></header><div class="mt-8 space-y-8">{groups.map(([date, items]) => <section class="rounded-xl border border-line bg-white p-5"><h2 class="text-2xl font-black">{formatDate(date)}</h2><div class="mt-4 space-y-4">{items!.map((item) => <article class="border-t border-line pt-4 first:border-0 first:pt-0"><h3 class="font-black"><a class="text-accent-dark underline" href={`/lawsuits/${item.slug}/`}>{item.caseName}</a></h3><p class="mt-1 leading-7 text-muted">{item.summary}</p><a class="mt-2 inline-block text-sm font-bold text-accent-dark underline" href={item.sourceUrl} data-track="source_click">Official source</a></article>)}</div></section>)}</div></div>
</BaseLayout>
