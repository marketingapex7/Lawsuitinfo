---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import StateGrid from "@components/StateGrid.astro";
import { entrySlug } from "@lib/content";
import { formatCount, getAllCaseData, latestPendingCount, monthlyChange, nextMajorDate } from "@lib/caseData";
import { formatDate } from "@lib/site";

const lawsuitEntries = await getCollection("lawsuits");
const cases = getAllCaseData();
const priority = ["afff-pfas", "suboxone", "ozempic", "roundup", "paraquat", "depo-provera", "bard-powerport", "camp-lejeune"];
const featured = priority.map((slug) => ({ data: cases.find((item) => item.slug === slug)!, entry: lawsuitEntries.find((item) => entrySlug(item) === slug)! })).filter((item) => item.data && item.entry);
const largest = cases.filter((item) => item.litigation.mdlNumber).sort((a, b) => (latestPendingCount(b)?.count ?? 0) - (latestPendingCount(a)?.count ?? 0)).slice(0, 5);
const recentSettlements = cases.filter((item) => item.settlements.some((entry) => entry.kind && entry.kind !== "none")).sort((a, b) => b.dataAsOf.localeCompare(a.dataAsOf)).slice(0, 4);
const today = new Date().toISOString().slice(0, 10);
const upcoming = cases.map((item) => ({ item, date: nextMajorDate(item, today) })).filter((row) => row.date).sort((a, b) => a.date!.date.localeCompare(b.date!.date)).slice(0, 4);
---
<BaseLayout title="Track the Status of Major U.S. Lawsuits" seoTitle="Major U.S. Lawsuit Status Tracker" description="Current MDL case counts, settlement status, bellwether schedules, deadlines and state-specific lawsuit information, verified from primary sources." isHome>
  <section class="border-b border-line bg-[#eaf5f6]"><div class="mx-auto max-w-6xl px-4 py-12 md:py-16"><p class="text-sm font-black uppercase tracking-[0.12em] text-accent-dark">Updated litigation data and primary sources</p><h1 class="mt-3 max-w-4xl text-4xl font-black leading-tight text-ink md:text-6xl">Track the Status of Major U.S. Lawsuits</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-muted">Current MDL case counts, settlement status, bellwether trials, deadlines and state-specific lawsuit information.</p><div class="mt-7 flex flex-wrap gap-3"><a class="rounded-md bg-accent px-5 py-3 text-sm font-bold text-white" href="#latest">View latest updates</a><a class="rounded-md border border-line bg-white px-5 py-3 text-sm font-bold" href="/updates/">Recently updated</a><a class="rounded-md border border-line bg-white px-5 py-3 text-sm font-bold" href="/states/">Browse by state</a></div></div></section>
  <div class="mx-auto max-w-6xl space-y-12 px-4 py-10">
    <nav class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Status trackers"><a class="rounded-xl border border-line bg-white p-4 font-black text-accent-dark shadow-sm" href="/mdl-statistics/">MDL Statistics <span aria-hidden="true">→</span></a><a class="rounded-xl border border-line bg-white p-4 font-black text-accent-dark shadow-sm" href="/settlements/">Settlement Tracker <span aria-hidden="true">→</span></a><a class="rounded-xl border border-line bg-white p-4 font-black text-accent-dark shadow-sm" href="/deadlines/">Lawsuit Deadlines <span aria-hidden="true">→</span></a><a class="rounded-xl border border-line bg-white p-4 font-black text-accent-dark shadow-sm" href="/states/">State Lawsuit Guides <span aria-hidden="true">→</span></a></nav>
    <section id="latest"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-sm font-black uppercase tracking-wide text-accent-dark">September 2026</p><h2 class="mt-1 text-3xl font-black">Latest Lawsuit Updates</h2></div><a class="font-bold text-accent-dark underline" href="/updates/">View the full update log</a></div><div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-4">{featured.map(({data,entry}) => { const count=latestPendingCount(data); const change=monthlyChange(data); return <article class="rounded-xl border border-line bg-white p-4 shadow-sm"><p class="text-xs font-black uppercase tracking-wide text-accent-dark">Updated {formatDate(data.dataAsOf)}</p><h3 class="mt-2 text-xl font-black"><a href={`/lawsuits/${data.slug}/`}>{entry.data.lawsuit}</a></h3><dl class="mt-4 space-y-2 text-sm"><div><dt class="font-bold text-muted">Proceeding</dt><dd>{data.litigation.mdlNumber ?? data.litigation.type}</dd></div><div><dt class="font-bold text-muted">Pending cases</dt><dd class="font-black">{count ? formatCount(count.count) : "Not an MDL"} {change !== undefined && <span class="text-xs font-semibold text-muted">({change>0?"+":""}{formatCount(change)})</span>}</dd></div><div><dt class="font-bold text-muted">Status</dt><dd>{data.phase}</dd></div></dl><a class="mt-4 inline-block font-bold text-accent-dark underline" href={`/lawsuits/${data.slug}/`}>View latest update</a></article>})}</div></section>
    <section class="grid gap-6 lg:grid-cols-3"><div class="rounded-xl border border-line bg-white p-5"><h2 class="text-2xl font-black">Largest MDLs</h2><ol class="mt-4 space-y-3">{largest.map((item,index)=><li class="flex items-center justify-between gap-3"><a class="font-bold text-accent-dark underline" href={`/mdl/${item.litigation.mdlNumber!.replace(/\D/g,"")}/`}>{index+1}. {item.caseName}</a><span class="whitespace-nowrap font-black">{formatCount(latestPendingCount(item)!.count)}</span></li>)}</ol><a class="mt-5 inline-block font-bold text-accent-dark underline" href="/mdl-statistics/">Compare all tracked MDLs</a></div><div class="rounded-xl border border-line bg-white p-5"><h2 class="text-2xl font-black">Recent Settlements</h2><ul class="mt-4 space-y-3">{recentSettlements.map((item)=><li><a class="font-bold text-accent-dark underline" href={`/lawsuits/${item.slug}/#settlement`}>{item.caseName}</a><p class="text-sm leading-6 text-muted">{item.settlements[0]?.status}</p></li>)}</ul><a class="mt-5 inline-block font-bold text-accent-dark underline" href="/settlements/">Open settlement tracker</a></div><div class="rounded-xl border border-line bg-white p-5"><h2 class="text-2xl font-black">Upcoming Deadlines</h2>{upcoming.length ? <ul class="mt-4 space-y-3">{upcoming.map(({item,date})=><li><a class="font-bold text-accent-dark underline" href={`/lawsuits/${item.slug}/`}>{item.caseName}</a><p class="text-sm leading-6 text-muted">{formatDate(date!.date)} — {date!.label}</p></li>)}</ul>:<p class="mt-4 text-sm text-muted">No future public dates are currently verified.</p>}<a class="mt-5 inline-block font-bold text-accent-dark underline" href="/deadlines/">Open deadline tracker</a></div></section>
    <section class="rounded-xl border border-line bg-[#eaf5f6] p-5"><h2 class="text-3xl font-black">Browse Lawsuits by State</h2><p class="mt-2 text-muted">State pages focus on local limitation periods and claim context while linking back to the current national status.</p><div class="mt-5"><StateGrid /></div></section>
    <section class="rounded-xl border border-line bg-white p-5"><h2 class="text-2xl font-black">All tracked lawsuits</h2><div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">{lawsuitEntries.sort((a,b)=>a.data.lawsuit.localeCompare(b.data.lawsuit)).map((entry)=><a class="rounded-md border border-line bg-panel px-3 py-2.5 text-sm font-bold hover:border-accent" href={`/lawsuits/${entrySlug(entry)}/`}>{entry.data.lawsuit}</a>)}</div></section>
  </div>
</BaseLayout>
