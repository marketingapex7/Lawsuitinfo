---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { formatCount, getAllCaseData, latestPendingCount, monthlyChange } from "@lib/caseData";
import { caseIntentHref } from "@lib/caseLinks";
import { datasetSchema } from "@lib/seo";

const cases = getAllCaseData();
const mdlRows = cases
  .filter((item) => item.litigation.mdlNumber)
  .map((item) => ({ ...item, headlineCount: latestPendingCount(item), change: monthlyChange(item) }))
  .sort((a, b) => (b.headlineCount?.count ?? 0) - (a.headlineCount?.count ?? 0));
const updated = cases.map((item) => item.dataAsOf).sort().at(-1) ?? "2026-06-19";
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "MDL Statistics", url: "/mdl-statistics/" }
];
---

<BaseLayout
  title="Mass Tort MDL Statistics"
  seoTitle="Mass Tort MDL Statistics 2026"
  description="Compare pending MDL counts, courts, judges, and source links for major mass tort and product-liability lawsuits."
  canonicalPath="/mdl-statistics/"
  breadcrumbs={breadcrumbs}
  extraSchemas={[
    datasetSchema({
      name: "Mass Tort MDL Statistics",
      description: "Pending action counts, courts, judges, and source links for active mass tort MDLs tracked by Lawsuit Status Guide.",
      url: "https://lawsuitstatusguide.com/mdl-statistics/",
      dateModified: updated,
      variables: [
        { name: "MDLs tracked", value: `${mdlRows.length}` },
        { name: "Pending action count", value: "JPML-derived where available" },
        { name: "Court and judge", value: "Federal MDL court assignment" }
      ]
    })
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-6 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-3xl">
      <p class="text-sm font-black uppercase tracking-wide text-accent-dark">September 2026</p>
      <h1 class="mt-2 text-4xl font-black tracking-normal text-ink">Mass Tort MDL Statistics</h1>
      <p class="mt-4 text-lg leading-8 text-muted">
        Compare the largest active mass tort MDLs tracked here using the September and August JPML reports. Counts are monthly snapshots, not live dockets.
      </p>
      <p class="mt-3 text-sm leading-6 text-muted">
        For case-specific context behind the numbers, review the <a class="font-bold text-accent-dark" href={caseIntentHref("afff-pfas", "update")}>AFFF MDL 2873 update</a> or the <a class="font-bold text-accent-dark" href={caseIntentHref("suboxone", "update")}>Suboxone dental-injury MDL 3092</a> guide.
      </p>
      <p class="mt-3 text-sm font-bold text-muted">Last verified: {updated}</p>
    </header>

    <section class="mt-8 rounded-lg border border-line bg-[#eef7f8] p-5"><h2 class="text-2xl font-black">What is an MDL?</h2><p class="mt-2 leading-7 text-muted">Multidistrict litigation transfers related federal civil cases to one judge for coordinated pretrial proceedings. It is not a class action: the individual cases generally remain separate, and an MDL count does not show how many people will receive compensation.</p></section>

    <section class="mt-8 overflow-hidden rounded-lg border border-line bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line text-left text-sm" data-mdl-table>
          <thead class="bg-panel text-xs uppercase tracking-[0.08em] text-muted">
            <tr>
              <th class="px-4 py-3">Rank</th>
              <th class="px-4 py-3"><button class="font-bold underline" type="button" data-sort="name">Case</button></th>
              <th class="px-4 py-3">MDL</th>
              <th class="px-4 py-3"><button class="font-bold underline" type="button" data-sort="pending">Pending Actions</button></th>
              <th class="px-4 py-3"><button class="font-bold underline" type="button" data-sort="change">Monthly Change</button></th>
              <th class="px-4 py-3">Court / Judge</th>
              <th class="px-4 py-3">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line" data-mdl-rows>
            {mdlRows.map((row, index) => (
              <tr class="align-top" data-name={row.caseName} data-pending={row.headlineCount?.count ?? -1} data-change={row.change ?? -999999}>
                <td class="px-4 py-4 font-bold text-muted">{index + 1}</td>
                <td class="px-4 py-4">
                  <a class="font-bold text-accent-dark" href={`/mdl/${row.litigation.mdlNumber!.replace(/\D/g, "")}/`}>{row.caseName}</a>
                  <div class="mt-1 text-xs text-muted">{row.phase}</div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap">{row.litigation.mdlNumber}</td>
                <td class="px-4 py-4 whitespace-nowrap">
                  {row.headlineCount ? (
                    <>
                      <div class="font-bold text-ink">{formatCount(row.headlineCount.count)}</div>
                      <div class="text-xs text-muted">{row.headlineCount.date}</div>
                    </>
                  ) : (
                    <span class="text-muted">Not listed</span>
                  )}
                </td>
                <td class="px-4 py-4 whitespace-nowrap font-bold">{row.change === undefined ? "—" : `${row.change > 0 ? "+" : ""}${formatCount(row.change)}`}</td>
                <td class="px-4 py-4">
                  <div class="font-bold text-ink">{row.litigation.courtShort ?? row.litigation.court}</div>
                  <div class="mt-1 text-xs text-muted">{row.litigation.judge}</div>
                </td>
                <td class="px-4 py-4">
                  {row.headlineCount?.sourceUrl ? (
                    <a class="font-bold text-accent-dark" href={row.headlineCount.sourceUrl}>{row.headlineCount.source}</a>
                  ) : (
                    <span class="text-muted">See case guide</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
    <section class="mt-8 grid gap-5 md:grid-cols-2"><div class="rounded-lg border border-line bg-white p-5"><h2 class="text-2xl font-black">Largest active MDLs</h2><p class="mt-2 leading-7 text-muted">The table ranks tracked proceedings by current pending actions. Open each dedicated MDL page for historical counts, defendants, current phase and source links.</p></div><div class="rounded-lg border border-line bg-white p-5"><h2 class="text-2xl font-black">Fastest-growing this month</h2><ol class="mt-3 space-y-2">{[...mdlRows].filter((row)=>row.change!==undefined).sort((a,b)=>(b.change??0)-(a.change??0)).slice(0,5).map((row)=><li><a class="font-bold text-accent-dark underline" href={`/mdl/${row.litigation.mdlNumber!.replace(/\D/g,"")}/`}>{row.caseName}: {row.change!>0?"+":""}{formatCount(row.change!)}</a></li>)}</ol></div></section>
  </div>
  <script>
  const table = document.querySelector<HTMLTableElement>("[data-mdl-table]");
  const body = table?.querySelector<HTMLTableSectionElement>("[data-mdl-rows]");
  table?.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((button) => button.addEventListener("click", () => {
    if (!body) return;
    const key = button.dataset.sort!;
    const direction = button.dataset.direction === "desc" ? "asc" : "desc";
    table.querySelectorAll<HTMLButtonElement>("[data-sort]").forEach((item) => delete item.dataset.direction);
    button.dataset.direction = direction;
    const rows = [...body.querySelectorAll<HTMLTableRowElement>("tr")];
    rows.sort((a, b) => {
      const av = a.dataset[key] ?? "";
      const bv = b.dataset[key] ?? "";
      const comparison = key === "name" ? av.localeCompare(bv) : Number(av) - Number(bv);
      return direction === "asc" ? comparison : -comparison;
    });
    rows.forEach((row, index) => { row.cells[0].textContent = String(index + 1); body.append(row); });
  }));
  </script>
</BaseLayout>
