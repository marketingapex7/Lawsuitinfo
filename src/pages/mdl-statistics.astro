---
import BaseLayout from "@layouts/BaseLayout.astro";
import Breadcrumbs from "@components/Breadcrumbs.astro";
import { formatCount, getAllCaseData, latestPendingCount, pendingCountChange } from "@lib/caseData";
import { isOfficialSourceUrl } from "@lib/sourceClassification";
import { caseIntentHref } from "@lib/caseLinks";
import { datasetSchema } from "@lib/seo";

const cases = getAllCaseData();
const mdlRows = cases
  .filter((item) => item.litigation.mdlNumber)
  .map((item) => ({ ...item, headlineCount: latestPendingCount(item), change: pendingCountChange(item) }))
  .sort((a, b) => (b.headlineCount?.count ?? 0) - (a.headlineCount?.count ?? 0));
const updated = cases.map((item) => item.dataAsOf).sort().at(-1) ?? "2026-06-19";
const comparableRows = mdlRows.filter((row) => row.change);
const increased = comparableRows.filter((row) => (row.change?.delta ?? 0) > 0).length;
const decreased = comparableRows.filter((row) => (row.change?.delta ?? 0) < 0).length;
const unchanged = comparableRows.length - increased - decreased;
const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "MDL Statistics", url: "/mdl-statistics/" }
];
---

<BaseLayout
  title="Mass Tort MDL Statistics"
  seoTitle="Mass Tort MDL Statistics 2026"
  description="Compare pending MDL counts, courts, judges, and source links for major mass tort and product-liability lawsuits."
  canonicalPath="/mdl-statistics/"
  breadcrumbs={breadcrumbs}
  extraSchemas={[
    datasetSchema({
      name: "Mass Tort MDL Statistics",
      description: "Pending action counts, courts, judges, and source links for active mass tort MDLs tracked by Lawsuit Status Guide.",
      url: "https://lawsuitstatusguide.com/mdl-statistics/",
      dateModified: updated,
      variables: [
        { name: "MDLs tracked", value: `${mdlRows.length}` },
        { name: "Pending action count", value: "JPML-derived where available" },
        { name: "Court and judge", value: "Federal MDL court assignment" }
      ]
    })
  ]}
>
  <div class="mx-auto max-w-6xl px-4 py-6 md:py-10">
    <Breadcrumbs items={breadcrumbs} />
    <header class="max-w-3xl">
      <h1 class="text-4xl font-black tracking-normal text-ink">Mass Tort MDL Statistics</h1>
      <p class="mt-4 text-lg leading-8 text-muted">
        A quick comparison of the federal multidistrict litigations tracked in the case database. Counts are snapshots, not live dockets, and can change monthly.
      </p>
      <p class="mt-3 text-sm leading-6 text-muted">
        For case-specific context behind the numbers, review the <a class="font-bold text-accent-dark" href={caseIntentHref("afff-pfas", "update")}>AFFF MDL 2873 update</a> or the <a class="font-bold text-accent-dark" href={caseIntentHref("suboxone", "update")}>Suboxone dental-injury MDL 3092</a> guide.
      </p>
      <p class="mt-3 text-sm font-bold text-muted">Data last aligned: {updated}</p>
    </header>

    <section data-monthly-change-summary class="mt-8 rounded-lg border border-line bg-panel p-5">
      <h2 class="text-2xl font-bold text-ink">Monthly pending-action changes</h2>
      <p class="mt-2 text-sm leading-6 text-muted">
        Comparable JPML snapshots are available for {comparableRows.length} tracked MDLs: {increased} increased, {decreased} decreased, and {unchanged} were unchanged. Changes reflect docket activity, not legal merit or expected outcome.
      </p>
    </section>

    <section class="mt-8 overflow-hidden rounded-lg border border-line bg-white shadow-sm">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-line text-left text-sm">
          <thead class="bg-panel text-xs uppercase tracking-[0.08em] text-muted">
            <tr>
              <th class="px-4 py-3">Rank</th>
              <th class="px-4 py-3">Case</th>
              <th class="px-4 py-3">MDL</th>
              <th class="px-4 py-3">Pending Actions</th>
              <th class="px-4 py-3">Monthly Change</th>
              <th class="px-4 py-3">Court / Judge</th>
              <th class="px-4 py-3">Source</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {mdlRows.map((row, index) => (
              <tr class="align-top">
                <td class="px-4 py-4 font-bold text-muted">{index + 1}</td>
                <td class="px-4 py-4">
                  <a class="font-bold text-accent-dark" href={caseIntentHref(row.slug, "update")}>{row.caseName}</a>
                  <div class="mt-1 text-xs text-muted">{row.phase}</div>
                </td>
                <td class="px-4 py-4 whitespace-nowrap">{row.litigation.mdlNumber}</td>
                <td class="px-4 py-4 whitespace-nowrap">
                  {row.headlineCount ? (
                    <>
                      <div class="font-bold text-ink">{formatCount(row.headlineCount.count)}</div>
                      <div class="text-xs text-muted">{row.headlineCount.date}</div>
                    </>
                  ) : (
                    <span class="text-muted">Not listed</span>
                  )}
                </td>
                <td class="px-4 py-4 whitespace-nowrap">
                  {row.change ? (
                    <>
                      <div class="font-bold text-ink">{row.change.delta > 0 ? "+" : ""}{formatCount(row.change.delta)}</div>
                      <div class="text-xs text-muted">
                        {row.change.percent === undefined ? "Percent unavailable" : (row.change.percent > 0 ? "+" : "") + row.change.percent.toFixed(1) + "%"}
                      </div>
                    </>
                  ) : <span class="text-muted">No comparable prior snapshot</span>}
                </td>
                <td class="px-4 py-4">
                  <div class="font-bold text-ink">{row.litigation.courtShort ?? row.litigation.court}</div>
                  <div class="mt-1 text-xs text-muted">{row.litigation.judge}</div>
                </td>
                <td class="px-4 py-4">
                  {row.headlineCount?.sourceUrl ? (
                    <a class="font-bold text-accent-dark" href={row.headlineCount.sourceUrl} data-official-source={isOfficialSourceUrl(row.headlineCount.sourceUrl) ? "" : undefined} data-component-location="mdl_tracker" data-case-slug={row.slug}>{row.headlineCount.source}</a>
                  ) : (
                    <span class="text-muted">See case guide</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
