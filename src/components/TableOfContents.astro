---
const { items = [] } = Astro.props;
const seenIds = new Set();
const seenLabels = new Set();
const dedupedItems = items.filter((item) => {
  const id = String(item.id).trim();
  const label = String(item.label).trim();
  const normalizedLabel = label.toLocaleLowerCase("en-US");
  if (!id || !label || seenIds.has(id) || seenLabels.has(normalizedLabel)) return false;
  seenIds.add(id);
  seenLabels.add(normalizedLabel);
  return true;
});
---

<details class="rounded-lg border border-line bg-white shadow-sm lg:hidden">
  <summary class="cursor-pointer list-none px-4 py-3 text-sm font-bold uppercase tracking-[0.08em] text-ink marker:hidden">
    On this page <span aria-hidden="true" class="float-right text-accent-dark">+</span>
  </summary>
  <nav data-page-toc class="border-t border-line px-4 py-3" aria-label="Page sections">
    <ol class="space-y-2 text-sm font-semibold leading-6 text-ink">
      {dedupedItems.map((item) => (
        <li><a class="block rounded-md px-2 py-1 hover:bg-panel hover:text-accent-dark" href={`#${item.id}`}>{item.label}</a></li>
      ))}
    </ol>
  </nav>
</details>

<nav data-page-toc class="hidden rounded-lg border border-line border-t-4 border-t-accent bg-white p-4 shadow-sm lg:block" aria-label="Page sections">
  <h2 class="text-sm font-bold uppercase tracking-[0.08em] text-muted">On this page</h2>
  <ol class="mt-3 space-y-2 text-sm font-semibold leading-6 text-ink">
    {dedupedItems.map((item) => (
      <li><a class="block rounded-md px-2 py-1 hover:bg-panel hover:text-accent-dark" href={`#${item.id}`}>{item.label}</a></li>
    ))}
  </ol>
</nav>
