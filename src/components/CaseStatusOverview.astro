---
import { formatCount, latestPendingCount, monthlyChange, nextMajorDate, type CaseData } from "@lib/caseData";
import { formatDate } from "@lib/site";

interface Props { data: CaseData; compact?: boolean }
const { data, compact = false } = Astro.props;
const pending = latestPendingCount(data);
const change = monthlyChange(data);
const next = nextMajorDate(data);
const settlement = data.settlements[0];
const settlementStatus = !settlement || settlement.status === "none"
  ? "No public settlement program identified"
  : settlement.status;
const mdlNumber = data.litigation.mdlNumber?.replace(/\D/g, "");
---

<section id="current-status" class="mt-8 rounded-xl border border-accent/25 bg-white p-5 shadow-sm md:p-6">
  <div class="flex flex-wrap items-start justify-between gap-3 border-b border-line pb-4">
    <div>
      <p class="text-xs font-black uppercase tracking-[0.12em] text-accent-dark">Lawsuit status — September 2026</p>
      <h2 class="mt-1 text-2xl font-black text-ink">{data.caseName}</h2>
    </div>
    <p class="rounded-full bg-[#eef7f8] px-3 py-1 text-xs font-bold text-accent-dark">Verified {formatDate(data.statusVerifiedOn ?? data.dataAsOf)}</p>
  </div>
  <dl class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {data.litigation.mdlNumber && <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">MDL</dt><dd class="mt-1 font-bold"><a class="text-accent-dark underline" href={`/mdl/${mdlNumber}/`} data-track="lawsuit_to_mdl">{data.litigation.mdlNumber}</a></dd></div>}
    <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">Court</dt><dd class="mt-1 text-sm font-semibold leading-6">{data.litigation.courtShort ?? data.litigation.court}</dd></div>
    <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">Judge</dt><dd class="mt-1 text-sm font-semibold leading-6">{data.litigation.judge ?? "Not applicable"}</dd></div>
    <div><dt class="text-xs font-bold uppercase tracking-wide text-muted">Pending cases</dt><dd class="mt-1 font-black">{pending ? formatCount(pending.count) : "Not an MDL count"}</dd>{change !== undefined && <dd class="text-xs text-muted">{change > 0 ? "+" : ""}{formatCount(change)} since prior report</dd>}</div>
    <div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-muted">Current phase</dt><dd class="mt-1 text-sm font-semibold leading-6">{data.phase}</dd></div>
    <div class="sm:col-span-2"><dt class="text-xs font-bold uppercase tracking-wide text-muted">Settlement status</dt><dd class="mt-1 text-sm font-semibold leading-6">{settlementStatus}</dd></div>
    {data.updates[0] && <div class="sm:col-span-2 lg:col-span-4"><dt class="text-xs font-bold uppercase tracking-wide text-muted">Latest development</dt><dd class="mt-1 text-sm font-semibold leading-6">{data.updates[0].summary}</dd></div>}
    <div class="sm:col-span-2 lg:col-span-4"><dt class="text-xs font-bold uppercase tracking-wide text-muted">Next major event</dt><dd class="mt-1 text-sm font-semibold leading-6">{next ? `${formatDate(next.date)} — ${next.label}` : "No future public court date is currently verified in this record."}</dd></div>
  </dl>
  {!compact && data.updates.length > 0 && <div class="mt-5 border-t border-line pt-4"><h3 class="text-lg font-black text-ink">What changed this month?</h3><ul class="mt-3 grid gap-2 text-sm leading-6 text-muted">{data.updates.slice(0, 5).map((item) => <li class="flex gap-2"><span class="text-accent">●</span><span>{item.summary} <a class="font-bold text-accent-dark underline" href={item.sourceUrl} data-track="source_click">Source</a></span></li>)}</ul></div>}
</section>
