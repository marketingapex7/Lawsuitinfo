---
import { formatDate } from "@lib/site";
import { isOfficialSourceUrl } from "@lib/sourceClassification";

const { lastReviewed, lastUpdated, sources = [], updateNote } = Astro.props;
---

<section class="mt-10 rounded-lg border border-line bg-[#f1f5f9] p-4" data-component-location="source_update_log">
  <h2 class="text-xl font-bold text-ink">Sources and Update Log</h2>
  <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
    <div>
      <dt class="font-bold text-muted">Last reviewed</dt>
      <dd class="mt-1 text-ink">{formatDate(lastReviewed)}</dd>
    </div>
    <div>
      <dt class="font-bold text-muted">Last updated</dt>
      <dd class="mt-1 text-ink">{formatDate(lastUpdated)}</dd>
    </div>
  </dl>
  {updateNote && (
    <p class="mt-4 text-sm leading-6 text-muted">
      <strong class="text-ink">Latest recorded change:</strong> {updateNote}
    </p>
  )}
  {sources.length > 0 ? (
    <div class="mt-4">
      <h3 class="text-sm font-bold text-ink">Case-level sources reviewed for this guide</h3>
      <ul class="mt-2 grid gap-2 text-sm leading-6">
        {sources.map((source) => (
          <li>
            <a class="font-semibold text-accent-dark underline underline-offset-3" href={source.url} data-official-source={isOfficialSourceUrl(source.url) ? "" : undefined}>
              {source.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <p class="mt-4 text-sm leading-6 text-muted">
      Source links and case-specific status notes appear in the guide above.
    </p>
  )}
</section>
